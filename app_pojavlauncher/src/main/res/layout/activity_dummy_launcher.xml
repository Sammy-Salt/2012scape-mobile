<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#231c09"
    tools:context=".ScapeLauncher">

    <TextView
        android:id="@+id/menuTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2012Scape"
        android:textColor="#e0c070"
        android:textSize="38sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/menuButtons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:id="@+id/menuButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/menuTitle">

        <Button
            android:id="@+id/playOnline"
            android:layout_width="220dp"
            android:layout_height="110dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/menu_button"
            android:text="Play Online"
            android:textAllCaps="false"
            android:textColor="#f5e6b8"
            android:textSize="22sp" />

        <Button
            android:id="@+id/playOffline"
            android:layout_width="220dp"
            android:layout_height="110dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/menu_button"
            android:text="Play Offline\n(coming soon)"
            android:textAllCaps="false"
            android:textColor="#9a8d66"
            android:textSize="20sp" />
    </LinearLayout>

    <Button
        android:id="@+id/devHello"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DEV: Java 17 test"
        android:textAllCaps="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/progress_layout" />

    <Button
        android:id="@+id/devExport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DEV: Export logs"
        android:textAllCaps="false"
        app:layout_constraintEnd_toStartOf="@+id/devHello"
        app:layout_constraintBottom_toTopOf="@+id/progress_layout" />

    <com.kdt.mcgui.ProgressLayout
        android:id="@+id/progress_layout"
        android:layout_width="733dp"
        android:layout_height="39dp"

        app:layout_constraintBottom_toBottomOf="parent"
        tools:layout_editor_absoluteX="-1dp" />

    <TextView
        android:id="@+id/settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Settings"
        android:textAllCaps="false"
        android:textColor="#B8A078"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/progress_layout"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
