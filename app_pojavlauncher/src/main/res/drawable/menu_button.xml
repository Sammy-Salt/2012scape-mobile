<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#5a4620" />
            <stroke android:width="2dp" android:color="#e0c070" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#2c2615" />
            <stroke android:width="2dp" android:color="#5c5233" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#3d3017" />
            <stroke android:width="2dp" android:color="#b8a078" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
